
#include <stdio.h>

#define MAX 1000

int main(void) {
    int a[MAX];
    int n, i, j, clave;

    printf("ORDENAMIENTO POR INSERCION\n");
    printf("Cantidad de elementos: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Cantidad no valida.\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &a[i]);
    }

    for (i = 1; i < n; i++) {
        clave = a[i];
        j = i - 1;

        while (j >= 0 && a[j] > clave) {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = clave;
    }

    printf("\nArreglo ordenado: ");

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    printf("\n");
    return 0;
}
