
#include <stdio.h>

#define MAX 1000

void intercambiar(int *a, int *b) {
    int auxiliar = *a;
    *a = *b;
    *b = auxiliar;
}

int particion(int a[], int bajo, int alto) {
    int pivote = a[alto];
    int i = bajo - 1;
    int j;

    for (j = bajo; j < alto; j++) {
        if (a[j] <= pivote) {
            i++;
            intercambiar(&a[i], &a[j]);
        }
    }

    intercambiar(&a[i + 1], &a[alto]);

    return i + 1;
}

void quickSort(int a[], int bajo, int alto) {
    if (bajo < alto) {
        int p = particion(a, bajo, alto);

        quickSort(a, bajo, p - 1);
        quickSort(a, p + 1, alto);
    }
}

int main(void) {
    int a[MAX];
    int n, i;

    printf("ORDENAMIENTO RAPIDO (QUICK SORT)\n");
    printf("Cantidad de elementos: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Cantidad no valida.\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &a[i]);
    }

    quickSort(a, 0, n - 1);

    printf("\nArreglo ordenado: ");

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    printf("\n");
    return 0;
}
