
#include <stdio.h>

#define MAX 1000

int busquedaLineal(int a[], int n, int objetivo) {
    int i;

    for (i = 0; i < n; i++) {
        if (a[i] == objetivo) {
            return i;
        }
    }

    return -1;
}

int main(void) {
    int a[MAX];
    int n;
    int objetivo;
    int posicion;
    int i;

    printf("BUSQUEDA LINEAL\n");
    printf("Cantidad de elementos: ");

    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Cantidad no valida.\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Elemento %d: ", i + 1);

        if (scanf("%d", &a[i]) != 1) {
            printf("Entrada no valida.\n");
            return 1;
        }
    }

    printf("Numero que desea buscar: ");

    if (scanf("%d", &objetivo) != 1) {
        printf("Entrada no valida.\n");
        return 1;
    }

    posicion = busquedaLineal(a, n, objetivo);

    if (posicion == -1) {
        printf("Elemento no encontrado.\n");
    } else {
        printf("Elemento encontrado en la posicion %d.\n",
               posicion + 1);
        printf("Indice del arreglo: %d\n", posicion);
    }

    return 0;
}
