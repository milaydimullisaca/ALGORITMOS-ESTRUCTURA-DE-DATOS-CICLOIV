
#include <stdio.h>

#define MAX 1000

int busquedaBinaria(int a[], int n, int objetivo) {
    int izquierda = 0;
    int derecha = n - 1;

    while (izquierda <= derecha) {
        int medio = izquierda + (derecha - izquierda) / 2;

        if (a[medio] == objetivo) {
            return medio;
        }

        if (a[medio] < objetivo) {
            izquierda = medio + 1;
        } else {
            derecha = medio - 1;
        }
    }

    return -1;
}

int main(void) {
    int a[MAX];
    int n;
    int objetivo;
    int posicion;
    int i;

    printf("BUSQUEDA BINARIA\n");
    printf("Ingrese la cantidad de elementos: ");

    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Cantidad no valida.\n");
        return 1;
    }

    printf("Ingrese los elementos en orden ascendente.\n");

    for (i = 0; i < n; i++) {
        printf("Elemento %d: ", i + 1);

        if (scanf("%d", &a[i]) != 1) {
            printf("Entrada no valida.\n");
            return 1;
        }

        if (i > 0 && a[i] < a[i - 1]) {
            printf("Error: el arreglo no esta ordenado.\n");
            return 1;
        }
    }

    printf("Numero que desea buscar: ");

    if (scanf("%d", &objetivo) != 1) {
        printf("Entrada no valida.\n");
        return 1;
    }

    posicion = busquedaBinaria(a, n, objetivo);

    if (posicion == -1) {
        printf("Elemento no encontrado.\n");
    } else {
        printf("Elemento encontrado en la posicion %d.\n",
               posicion + 1);
        printf("Indice del arreglo: %d\n", posicion);
    }

    return 0;
}
