
#include <stdio.h>

long long factorial(int n) {
    if (n == 0 || n == 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

int main(void) {
    int n;

    printf("FACTORIAL RECURSIVO\n");
    printf("Ingrese un numero entre 0 y 20: ");

    if (scanf("%d", &n) != 1 || n < 0 || n > 20) {
        printf("Numero no valido.\n");
        return 1;
    }

    printf("Factorial de %d = %lld\n", n, factorial(n));

    return 0;
}
