
#include <stdio.h>

long long fibonacci(int n) {
    if (n == 0) {
        return 0;
    }

    if (n == 1) {
        return 1;
    }

    return fibonacci(n - 1) + fibonacci(n - 2);
}

int main(void) {
    int n, i;

    printf("SUCESION DE FIBONACCI\n");
    printf("Ingrese la cantidad de terminos (1 a 40): ");

    if (scanf("%d", &n) != 1 || n < 1 || n > 40) {
        printf("Cantidad no valida.\n");
        return 1;
    }

    printf("Sucesion: ");

    for (i = 0; i < n; i++) {
        printf("%lld ", fibonacci(i));
    }

    printf("\n");
    return 0;
}
